# =============================================================================
# Level Crossing Safety Monitoring System - Environment Configuration Template
# Copy this file to '.env' and populate with your production credentials.
# WARNING: NEVER commit your actual '.env' with real secrets to version control.
# =============================================================================

# Telegram Emergency Dispatcher Configuration
# 1. Obtain Bot Token from @BotFather on Telegram (e.g., /newbot)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Obtain numeric Chat ID by sending /start to @userinfobot or your bot
TELEGRAM_CHAT_ID=1295515495

# Level Crossing Location Identifier
CROSSING_LOCATION=LC-102

# 6-Digit Admin Security PIN for UI Credentials Unlocking (Default: 123456)
OCC_ADMIN_PIN=123456

# Optional Operations Webhook URL for central SCADA/OCC
OCC_WEBHOOK_URL=https://railway-occ.internal/api/v1/alerts
